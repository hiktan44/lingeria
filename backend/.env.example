# LingeriaFasheone Backend Environment Variables

# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://lingeriafasheone.com

# Database (Supabase / Postgres)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Redis & Queue
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# External AI Integrations (Kie.ai Unified API)
KIE_API_KEY=your-kie-api-key
KIE_BASE_URL=https://api.kie.ai

# Google Gemini (for image analysis)
GEMINI_API_KEY=your-gemini-api-key
